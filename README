Open docker app
go to project root
start postgres: docker compose up -d
go to backend folder
set db connection string: $env:DATABASE_URL = "postgres://pulse:pulse_dev_password@127.0.0.1:5432/pulse?sslmode=disable"
start api: go run ./cmd/api

run entire test suits: go test ./... -v

